<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="15"
      prefWidth="420"
      prefHeight="300"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.AutoFix.controller.AprobacionCalidadController">

    <children>

        <Label text="AutoFix - Aprobación de calidad"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <Label text="Ingrese el ID de la orden de trabajo:"/>

        <TextField fx:id="txtIdOrden"
                   promptText="ID de la orden"
                   maxWidth="220"/>

        <Button text="Aprobar calidad"
                onAction="#aprobarCalidad"/>

        <Button text="Cerrar"
                onAction="#cerrarVentana"/>

    </children>

</VBox>
